# APCOTEX Sales Insights — Backend environment (example)
# Copy to `.env` and fill in real values. Never commit secrets.

# ==========================================
# Application / UAT bind
# ==========================================
APP_NAME=APCOTEX Sales Insights API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ==========================================
# CORS — comma-separated browser Origins (exact match: scheme + host + port)
# List EVERY origin users open in the browser. Whitespace is trimmed.
# Local development AND Windows Server UAT can both be listed at once.
# ==========================================
#
# Local Development (required for http://localhost:5173):
#   http://localhost:5173
#   http://127.0.0.1:5173
#
# Windows Server UAT (VPN users open http://<SERVER-IP>:5173):
#   Replace <SERVER-IP> with the real address (e.g. 10.0.3.213).
#   Keep localhost entries so server-side local testing still works.
#
# Example — local only:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# Example — local + UAT together (recommended for Windows Server):
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://<SERVER-IP>:5173
#
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# PostgreSQL (same server → localhost is correct)
# ==========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=apcotex_salesinsights
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg2://postgres:changeme@localhost:5432/apcotex_salesinsights

# ==========================================
# Microsoft Graph (fill from Azure app registration)
# Application (client credentials) permissions required:
#   - Mail.Read   (existing Outlook sync / unread ingest)
#   - Mail.ReadWrite  (create drafts in GRAPH_MAILBOX — admin consent required)
# Do NOT use /sendMail — drafts are reviewed and sent manually in Outlook.
# ==========================================
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=salesinsights@apcotex.com

# ==========================================
# Logging / paths
# ==========================================
LOG_LEVEL=INFO
MASTER_HISTORY_RETENTION_DAYS=180

# Auth: headers (local/VPN UAT) | trusted_headers | jwt
AUTH_MODE=headers

# Super Admin is hardcoded in the app (username=superadmin) — do not set password here.
PASSWORD_MIN_LENGTH=8
