# APCOTEX Sales Insights — Frontend environment
# Copy to `.env.local` (or `.env`) and replace <SERVER-IP> for UAT.
# Never commit real secrets. Do not hardcode IPs in source code.

# Backend API base (must include /api suffix used by the client)
# Local development:
VITE_API_BASE_URL=http://localhost:8000/api

# Windows Server UAT (VPN users open http://<SERVER-IP>:5173):
# VITE_API_BASE_URL=http://<SERVER-IP>:8000/api
