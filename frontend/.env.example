# APCOTEX Sales Insights — Frontend environment
# Copy to `.env.local` (or `.env`). Never commit secrets. Do not hardcode IPs in source.

# Backend API base (must include the /api suffix used by the client).
#
# Local Development:
#   Frontend: http://localhost:5173
#   API:      http://localhost:8000/api
VITE_API_BASE_URL=http://localhost:8000/api

# Windows Server UAT (VPN users open http://<SERVER-IP>:5173):
#   Set this to the same host users use for the API (not their laptop localhost):
# VITE_API_BASE_URL=http://<SERVER-IP>:8000/api
#
# Also set backend CORS_ORIGINS to include http://<SERVER-IP>:5173 (see backend/.env.example).
